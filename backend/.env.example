# Conexion a Postgres (contenedor ropaDocker)
DATABASE_URL=postgresql+asyncpg://yimysito:tarqui231@localhost:5432/ropaDB

# JWT
SECRET_KEY=change_me_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS - en dev permitimos Angular (3000) y Flutter
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080","http://127.0.0.1:3000"]

# Respaldos por empresa (migracion 018)
# Bucket PRIVADO de Supabase Storage (distinto del de imagenes). Vacio = disco local (solo desarrollo).
BACKUP_BUCKET=
# Secreto compartido con GitHub Actions para disparar los respaldos automaticos.
# Generarlo con: python -c "import secrets; print(secrets.token_urlsafe(48))"
BACKUP_CRON_SECRET=
BACKUP_RETENCION_AUTOMATICOS=7

# URL del frontend web, usada para armar el enlace de recuperacion de contrasena
FRONTEND_URL=http://localhost:3000

# Correo de recuperacion de contrasena: API transaccional de Brevo
# (app/email_utils.py). Las variables SMTP_* que habia aca ya no se usan.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=YouShop

# Solo desarrollo. Con DEBUG=true y sin Brevo configurado, /api/auth/forgot-password
# devuelve el token de recuperacion en la respuesta (reset_token_dev) para probar
# el flujo sin correo. En produccion debe quedar en false.
DEBUG=false
